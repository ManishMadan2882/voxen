# LLM provider — `gemini` (default) or `ollama`
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=

# Embedder — currently always uses Ollama. Either run Ollama via the `ollama`
# Compose profile, or point this at an external Ollama host that has the model.
EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://ollama:11434

# Logging
LOG_LEVEL=INFO

# Production-only (used by docker-compose.prod.yml)
POSTGRES_USER=voxen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=voxen
BACKEND_WORKERS=2
FRONTEND_PORT=80

# Comma-separated list of allowed CORS origins (backend).
# Dev default: http://localhost:5173
# Prod: set to every origin that embeds the widget or loads the dashboard.
CORS_ORIGINS=https://yourdomain.com,https://widget-host.example.com

# Public URL of the backend API (baked into the frontend at build time in prod,
# read from the environment at dev-server start time).
VITE_API_URL=https://api.yourdomain.com
